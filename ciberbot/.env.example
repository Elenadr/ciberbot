# Copia este archivo como .env y rellena tus datos. NUNCA subas .env a GitHub.

# --- Telegram (gratis) ---
# Token del bot (te lo da @BotFather)
TELEGRAM_BOT_TOKEN=123456789:AAAA-tu-token
# Tu chat id (ver README para obtenerlo)
TELEGRAM_CHAT_ID=123456789

# --- IA que hace el resumen ---
#   groq      -> gratis, sin tarjeta (console.groq.com). Opción por defecto.
#   ollama    -> gratis y local, si tienes un PC con Ollama instalado
#   anthropic -> Claude, de pago (céntimos al mes)
#   none      -> sin IA: titulares originales con enlace, sin agrupar
AI_PROVIDER=groq
GROQ_API_KEY=gsk_...
# AI_MODEL=openai/gpt-oss-120b      # opcional: cambia el modelo del proveedor
# AI_BASE_URL=http://192.168.1.50:11434/v1   # opcional: Ollama en otra máquina
# ANTHROPIC_API_KEY=sk-ant-...      # solo si AI_PROVIDER=anthropic

# --- Ajustes ---
# Horas hacia atrás que se revisan en cada ejecución
HOURS_BACK=24
# Máximo de noticias en el resumen
MAX_ITEMS=15
# Incluir las nuevas entradas del catálogo KEV de CISA
INCLUDE_CISA_KEV=true
